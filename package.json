{
	"name": "chet-stack",
	"version": "0.0.1",
	"description": "A spiritual successor to Meteor.js",
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"codegen-watch": "tsx src/codegen/codegen.ts src --watch",
		"server-watch": "tsx watch --clear-screen=false src/server/server.ts",
		"dev": "run-p codegen-watch server-watch",
		"ui": "vite src/ui",
		"clean": "rm -rf build db",
		"codegen": "tsx src/codegen/codegen.ts src",
		"build": "NODE_ENV=production vite build src/client",
		"start": "NODE_ENV=production tsx src/server/server.ts",
		"fix-imports": "tsx src/lint/fixImports.ts",
		"check-imports": "tsx src/lint/checkImports.ts",
		"typecheck": "tsc --noEmit",
		"prettier": "npx prettier src --write --list-different",
		"lint": "run-s codegen fix-imports prettier typecheck",
		"test": "run-s test:unit test:e2e",
		"test:unit": "mocha -r tsx './src/**/*.test.ts' --verbose",
		"test:e2e": "playwright test",
		"reset": "tsx src/tools/reset.ts",
		"migrate": "tsx src/server/migrations/migrate.ts",
		"sowell": "tsx src/tools/sowell.ts",
		"knip": "npx knip"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.70.0",
		"@ccorcos/ordered-array": "^0.0.4",
		"@popperjs/core": "^2.11.8",
		"@vitejs/plugin-react": "^5.1.1",
		"better-sqlite3": "^12.4.1",
		"cheerio": "^1.1.2",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"csv": "^6.4.1",
		"csv-parse": "^6.1.0",
		"culori": "^4.0.2",
		"date-fns": "^4.1.0",
		"dotenv": "^17.2.3",
		"helmet": "^8.1.0",
		"idb": "^8.0.3",
		"lexicodec": "^0.0.6",
		"lodash-es": "^4.17.21",
		"md5": "^2.3.0",
		"morgan": "^1.10.1",
		"openai": "^6.9.1",
		"p-limit": "^7.2.0",
		"prosemirror-model": "^1.25.4",
		"prosemirror-schema-basic": "^1.2.4",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.41.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"secure-compare": "^3.0.1",
		"serialize-error": "^12.0.0",
		"uuid": "^13.0.0",
		"vcf": "^2.1.2",
		"vite": "^7.2.2",
		"ws": "^8.18.3",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.56.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/cheerio": "^1.0.0",
		"@types/culori": "^4.0.1",
		"@types/express": "^5.0.5",
		"@types/lodash-es": "^4.17.12",
		"@types/madge": "^5.0.3",
		"@types/md5": "^2.3.6",
		"@types/mocha": "whitecolor/mocha-types",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.6",
		"@types/react-dom": "^19.2.3",
		"@types/uuid": "^11.0.0",
		"@types/vcf": "^2.0.7",
		"chokidar": "^4.0.3",
		"express": "^5.1.0",
		"ignore": "^7.0.5",
		"madge": "^8.0.0",
		"mocha": "^11.7.5",
		"npm-run-all": "^4.1.5",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vite-tsconfig-paths": "^5.1.4"
	}
}
