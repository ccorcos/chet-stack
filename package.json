{
	"name": "chet-stack",
	"version": "0.0.1",
	"description": "A spiritual successor to Meteor.js",
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"codegen-watch": "tsx src/codegen/codegen.ts src --watch",
		"server-watch": "tsx watch --clear-screen=false src/server/server.ts",
		"dev": "run-p codegen-watch server-watch",
		"clean": "rm -rf build db",
		"codegen": "tsx src/codegen/codegen.ts src",
		"build": "NODE_ENV=production vite build src/client",
		"start": "NODE_ENV=production tsx src/server/server.ts",
		"typecheck": "tsc --noEmit",
		"test": "run-s test:unit test:e2e",
		"test:unit": "mocha -r tsx './src/**/*.test.ts' --verbose",
		"test:e2e": "playwright test",
		"reset": "tsx src/tools/reset.ts",
		"migrate": "tsx src/server/migrations/migrate.ts",
		"sowell": "tsx src/tools/sowell.ts",
		"knip": "npx knip",
		"format": "prettier --write 'src/**/*.{ts,tsx,js,jsx}'"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.39.0",
		"@ccorcos/ordered-array": "^0.0.4",
		"@popperjs/core": "^2.11.8",
		"@vitejs/plugin-react": "^5.1.0",
		"better-sqlite3": "^11.3.0",
		"cheerio": "^1.0.0",
		"cookie-parser": "^1.4.6",
		"csv": "^6.3.10",
		"csv-parse": "^5.5.6",
		"culori": "^4.0.1",
		"date-fns": "^2.30.0",
		"dotenv": "^16.4.7",
		"helmet": "^7.0.0",
		"idb": "^7.1.1",
		"lexicodec": "^0.0.5",
		"lodash-es": "^4.17.21",
		"md5": "^2.3.0",
		"morgan": "^1.10.0",
		"openai": "^4.86.2",
		"p-limit": "^7.2.0",
		"prosemirror-model": "^1.25.1",
		"prosemirror-schema-basic": "^1.2.4",
		"prosemirror-state": "^1.4.3",
		"prosemirror-view": "^1.39.2",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"secure-compare": "^3.0.1",
		"serialize-error": "^11.0.2",
		"uuid": "^9.0.1",
		"vcf": "^2.1.2",
		"vite": "^7.2.0",
		"ws": "^8.13.0",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.38.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/cheerio": "^0.22.35",
		"@types/culori": "^2.1.1",
		"@types/express": "^4.17.17",
		"@types/lodash-es": "^4.17.12",
		"@types/md5": "^2.3.3",
		"@types/mocha": "whitecolor/mocha-types",
		"@types/node": "^20.3.3",
		"@types/react": "^18.2.14",
		"@types/react-dom": "^18.2.6",
		"@types/uuid": "^9.0.4",
		"@types/vcf": "^2.0.7",
		"chokidar": "^3.6.0",
		"express": "^4.18.2",
		"ignore": "^7.0.5",
		"mocha": "^11.0.1",
		"npm-run-all": "^4.1.5",
		"playwright": "^1.38.1",
		"prettier": "^3.6.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}
